{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "hFlow Help",
  "colors": {
    "primary": "#4F46E5",
    "light": "#6366F1",
    "dark": "#312E81"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://help.hflow.pro"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Using hFlow",
            "pages": [
              "hflow/students",
              "hflow/students/roles-and-permissions",
              "hflow/students/add-students",
              "hflow/students/delete-student",
              "hflow/students/view-student-data",
              "hflow/students/student-progress-charts",
              "hflow/assessments",
              "hflow/tiers",
              "hflow/workflows"
            ]
          },
          {
            "group": "Administration",
            "pages": ["hflow/admin-settings"]
          },
          {
            "group": "Support",
            "pages": ["hflow/troubleshooting", "hflow/changelog"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "hFlow",
          "href": "https://hflow.pro",
          "icon": "house"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:support@hflow.pro"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open hFlow",
      "href": "https://hflow.pro"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gils1908/hFlowDocs"
    }
  }
}
