{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "hFlow Help",
  "colors": {
    "primary": "#4F46E5",
    "light": "#6366F1",
    "dark": "#312E81"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://help.hflow.pro"
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/development",
      "destination": "/",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Help",
        "groups": [
          {
            "group": "Welcome",
            "pages": ["index", "hflow/getting-started"]
          },
          {
            "group": "Students",
            "pages": [
              "hflow/students",
              {
                "group": "Guides",
                "pages": [
                  "hflow/students/roles-and-permissions",
                  "hflow/students/view-student-data",
                  "hflow/students/add-students",
                  "hflow/students/delete-student",
                  "hflow/students/student-progress-charts",
                  "hflow/students/candidate-students"
                ]
              }
            ]
          },
          {
            "group": "Assessments",
            "pages": ["hflow/assessments", "hflow/actfl-proficiency-scale"]
          },
          {
            "group": "Reports",
            "pages": [
              "hflow/reports",
              {
                "group": "Organization reports",
                "pages": [
                  "hflow/reports/reading-tier-distribution",
                  "hflow/reports/growth-reading",
                  "hflow/reports/language-progress-report",
                  "hflow/reports/grade-language-distribution"
                ]
              }
            ]
          },
          {
            "group": "Tiers",
            "pages": ["hflow/tiers"]
          },
          {
            "group": "Languages",
            "pages": ["hflow/languages"]
          },
          {
            "group": "Communications",
            "pages": ["hflow/communications"]
          },
          {
            "group": "Configuration",
            "pages": [
              "hflow/configuration/org-profile",
              "hflow/configuration/email-templates",
              "hflow/configuration/staff",
              "hflow/configuration/data-exports",
              "hflow/configuration/benchmarks",
              "hflow/configuration/tier-rules"
            ]
          },
          {
            "group": "Support",
            "pages": ["hflow/troubleshooting", "hflow/changelog"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "hFlow",
          "href": "https://hflow.pro",
          "icon": "house"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:support@hflow.pro"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open hFlow",
      "href": "https://hflow.pro"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gils1908/hFlowDocs"
    }
  }
}
